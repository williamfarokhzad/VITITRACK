# Server-side secrets only. Never commit values.
AMD_API_KEY=
# OpenAI-compatible base including /v1, without /chat/completions
AMD_BASE_URL=
# Exact Gemma model ID from the approved AMD endpoint
AMD_MODEL=
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=
# Comma-separated emails, independently verified by the project owner.
CLINICIAN_EMAILS=
# Token Factory documented endpoint: https://developer.amd.com.cn/radeon/api/v1
# Gemma model in event guide: Gemma-4-31B-IT. Verify /models before use.
# This provider accepts no sensitive health data; app restricts AMD to fixed demo inputs.
GOOGLE_AI_API_KEY=
# Change only after checking current availability for your project.
GOOGLE_AI_MODEL=gemini-3.5-flash-lite
# Owner-only API settings. Never use the shared Doctor demo login for administration.
# Hosting already configures these values privately; do not commit actual values.
INTEGRATION_ADMIN_EMAILS=
# Exactly 32 random bytes, base64url-encoded. Keep stable or saved keys cannot decrypt.
CREDENTIAL_ENCRYPTION_KEY=
